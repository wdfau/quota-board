{
  "name": "quota-board-windows",
  "version": "1.0.0",
  "private": true,
  "description": "Quota Board for the Windows notification area",
  "type": "module",
  "main": "src/main.js",
  "license": "MIT",
  "author": "Quota Board contributors",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:ui": "node scripts/smoke.mjs",
    "dist": "electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.30",
    "cross-spawn": "7.0.6",
    "which": "2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "@electron/universal": { "minimatch": "^11.0.1" },
    "app-builder-lib": { "minimatch": "^11.0.1" }
  },
  "build": {
    "appId": "org.quotaboard.windows",
    "productName": "Quota Board",
    "artifactName": "QuotaBoard-windows-${arch}-${version}.${ext}",
    "directories": { "output": "release" },
    "files": ["src/**", "core/**", "scripts/claude-statusline.mjs", "LICENSE"],
    "asarUnpack": ["node_modules/@github/**"],
    "win": {
      "icon": "src/tray.ico",
      "target": ["zip"],
      "signAndEditExecutable": false
    }
  }
}
